# Solo para desarrollo. Copia este archivo como .env; .gitignore lo excluye del repositorio.
# Los instaladores NO leen este archivo ni contienen la clave: usan el servidor de Nexium (server/).

# Clave de la API de Gemini, creada en https://aistudio.google.com/apikey
# En desarrollo, sin NEXIUM_AI_SERVER_URL, Nexium llama directamente a Gemini con esta clave.
GEMINI_API_KEY=
