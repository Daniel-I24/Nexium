{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexium",
  "version": "1.0.2",
  "identifier": "io.github.daniel-i24.nexium",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nexium",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 400,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "12.3"
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2"
        ]
      }
    },
    "publisher": "Daniel-I24",
    "copyright": "© 2026 Daniel-I24. Licencia MIT.",
    "category": "Productivity",
    "shortDescription": "Asistente inteligente de escritorio",
    "longDescription": "Nexium responde por voz o por escrito sobre tu equipo, el clima, tus archivos y documentos, recordatorios y lo que ves en pantalla. La voz se transcribe en el equipo.",
    "windows": {
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "es-ES"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExRDUxNkE2QjY2RTJBMTUKUldRVkttNjJwaGJWb1Fyd0JsMldMbkx6ZkxoMVpKVDhQUDNBWnIvaTBVR091dVN6UUNCd1RYcXcK",
      "endpoints": [
        "https://github.com/Daniel-I24/Nexium/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
